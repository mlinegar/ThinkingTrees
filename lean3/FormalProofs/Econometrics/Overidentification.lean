/-!
# FormalProofs/Econometrics/Overidentification

Paper-facing re-exports for "Overidentification in Regular Models".

The generic proofs live in `FormalProbability`. This file exposes a curated API with docstrings that
record the corresponding numbered claims from the paper.
-/

set_option linter.mathlibStandardSet false

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

namespace Econometrics
namespace OveridentificationRegularModels

open Semiparametric

/-- Paper Definition 2.1: differentiable-in-quadratic-mean paths. -/
abbrev DQMPath (Ω : Type*) [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ] :=
  Semiparametric.DQMPath Ω μ

/-- Concrete score space `L²₀(P)` generated by the mean-zero restriction. -/
abbrev CenteredScoreSpace (Ω : Type*) [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ] :=
  Semiparametric.CenteredScoreSpace Ω μ

/-- Dominated-model square-root density notation. -/
abbrev squareRootDensity (Ω : Type*) [MeasurableSpace Ω]
    (ν μ : MeasureTheory.Measure Ω) :=
  Semiparametric.squareRootDensity ν μ

/-- Canonical local alternative scaling `h / √n`. -/
abbrev localAlternativeScale := Semiparametric.localAlternativeScale

/-- Base `n`-sample product law under the reference measure. -/
abbrev baseSampleMeasure (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ] (n : ℕ) :=
  Semiparametric.baseSampleMeasure μ n

/-- Product experiment induced by a concrete DQM path. -/
abbrev sampleMeasure (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (n : ℕ) (t : ℝ) :=
  Semiparametric.sampleMeasure (μ := μ) p n t

/-- Coordinatewise sample log-likelihood ratio. -/
abbrev sampleLogLikelihoodRatio (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (n : ℕ) (t : ℝ) :=
  Semiparametric.sampleLogLikelihoodRatio (μ := μ) p n t

/-- Normalized sample score sum attached to a DQM path. -/
abbrev normalizedScoreSum (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (n : ℕ) :=
  Semiparametric.normalizedScoreSum (μ := μ) p n

/-- Witness that the coordinatewise sample log-likelihood ratio agrees with the true product
log-likelihood ratio. -/
abbrev ProductLogLikelihoodRatioWitness (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (n : ℕ) (t : ℝ) :=
  Semiparametric.ProductLogLikelihoodRatioWitness (μ := μ) p n t

/-- Witness-backed quadratic product-LAN expansion. -/
abbrev ProductLANWitness (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (h : ℝ) :=
  Semiparametric.ProductLANWitness (μ := μ) p h

/-- Exponentially tilted concrete local-alternative constructor. -/
abbrev ExponentialTiltPath (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ] :=
  Semiparametric.ExponentialTiltPath Ω μ

/-- Coordinatewise sample log-likelihood ratio for an exponential tilt. -/
abbrev exponentialTiltSampleLogLikelihoodRatio (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    (tilt : Semiparametric.ExponentialTiltPath Ω μ) (n : ℕ) (t : ℝ) :=
  Semiparametric.exponentialTiltSampleLogLikelihoodRatio (μ := μ) tilt n t

/-- Finite probe families for finite-dimensional local-alternative statistics. -/
abbrev FiniteProbeFamily (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ] (d : ℕ) :=
  Semiparametric.FiniteProbeFamily (Ω := Ω) (μ := μ) d

/-- Bundled finite-dimensional CLT interface. -/
abbrev FiniteProbeCLT (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    {d : ℕ} (seq : ℕ → Ω → EuclideanSpace ℝ (Fin d))
    (limit : Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  ProbabilityTheory.FiniteProbeCLT (Ω := Ω) (μ := μ) seq limit

/-- Cramér-Wold witness interface for finite-dimensional CLTs. -/
abbrev CramerWoldWitness (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    {d : ℕ} (seq : ℕ → Ω → EuclideanSpace ℝ (Fin d))
    (limit : Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  ProbabilityTheory.CramerWoldWitness (Ω := Ω) (μ := μ) seq limit

/-- Witness-backed finite-probe third-lemma conclusion. -/
abbrev FiniteProbeThirdLemmaWitness (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    [MeasureTheory.IsFiniteMeasure μ]
    {d : ℕ} (probes : Semiparametric.FiniteProbeFamily (Ω := Ω) (μ := μ) d)
    (g : Semiparametric.CenteredScoreSpace Ω μ) :=
  Semiparametric.FiniteProbeThirdLemmaWitness (μ := μ) probes g

/-- Concrete path-generated tangent space in centered `L²₀(P)`. -/
abbrev pathwiseTangentSpace (Ω : Type*) [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) :=
  Semiparametric.dqmTangentSpace (μ := μ) paths

/-- First-order expansion along a local-alternative sequence. -/
abbrev HasFirstOrderLocalExperimentExpansion (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (τ : ℕ → ℝ) : Prop :=
  Semiparametric.HasFirstOrderLocalExperimentExpansion (μ := μ) p τ

/-- Absolute-continuity contiguity of a local-alternative sequence to the base model. -/
abbrev LocallyContiguous (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (τ : ℕ → ℝ) : Prop :=
  Semiparametric.LocallyContiguous (μ := μ) p τ

/-- Concrete Gaussian-shift experiment attached to a dominated DQM family. -/
abbrev ConcreteGaussianShiftExperiment (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) :=
  Semiparametric.ConcreteGaussianShiftExperiment (μ := μ) paths

/-- Concrete local just identification from DQM paths. -/
abbrev IsPathwiseLocallyJustIdentified (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) : Prop :=
  Semiparametric.IsPathwiseLocallyJustIdentified (μ := μ) paths

/-- Concrete local overidentification from DQM paths. -/
abbrev IsPathwiseLocallyOveridentified (Ω : Type*) [MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) : Prop :=
  Semiparametric.IsPathwiseLocallyOveridentified (μ := μ) paths

/-- Paper Definition 2.2: local just identification. -/
abbrev IsLocallyJustIdentified {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) : Prop :=
  Semiparametric.IsLocallyJustIdentified T

/-- Paper Definition 2.2: local overidentification. -/
abbrev IsLocallyOveridentified {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) : Prop :=
  Semiparametric.IsLocallyOveridentified T

/-- Concrete DQM path scores belong to the tangent space they generate. -/
theorem dqmPathScore_mem_pathwiseTangentSpace
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure μ]
    {paths : Set (Semiparametric.DQMPath Ω μ)} {p : Semiparametric.DQMPath Ω μ}
    (hp : p ∈ paths) :
    p.scoreDirection ∈ Semiparametric.dqmTangentSpace (μ := μ) paths :=
  Semiparametric.DQMPath.scoreDirection_mem_dqmTangentSpace (μ := μ) hp

/-- Dominated-path log-likelihood ratios vanish at the base point. -/
theorem localLogLikelihoodRatio_vanishesAtBase
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ] (p : Semiparametric.DQMPath Ω μ) :
    Semiparametric.localLogLikelihoodRatio p 0 =ᵐ[μ] 0 :=
  p.localLogLikelihoodRatio_atZero_ae_eq_zero

/-- Path-generated tangent spaces are monotone in the underlying path family. -/
theorem pathwiseTangentSpace_mono
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    {paths₁ paths₂ : Set (Semiparametric.DQMPath Ω μ)} (h : paths₁ ⊆ paths₂) :
    Semiparametric.dqmTangentSpace (μ := μ) paths₁ ≤
      Semiparametric.dqmTangentSpace (μ := μ) paths₂ :=
  Semiparametric.dqmTangentSpace_mono (μ := μ) h

/-- Unions of path families generate the closed supremum of the individual tangent spaces. -/
theorem pathwiseTangentSpace_union_eq_closedSup
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths₁ paths₂ : Set (Semiparametric.DQMPath Ω μ)) :
    Semiparametric.dqmTangentSpace (μ := μ) (paths₁ ∪ paths₂) =
      ((Submodule.span ℝ (Semiparametric.dqmScoreSet (μ := μ) paths₁)) ⊔
        (Submodule.span ℝ (Semiparametric.dqmScoreSet (μ := μ) paths₂))).topologicalClosure :=
  Semiparametric.dqmTangentSpace_union_eq (μ := μ) paths₁ paths₂

/-- Concrete pathwise local just identification is exactly the statement that the generated DQM
tangent space is all of `L²₀(P)`. -/
theorem pathwiseLocalJustIdentification_iff_generatedTangent_eq_top
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) :
    Semiparametric.IsPathwiseLocallyJustIdentified (μ := μ) paths ↔
      Semiparametric.dqmTangentSpace (μ := μ) paths = ⊤ :=
  Semiparametric.isPathwiseLocallyJustIdentified_iff_dqmTangentSpace_eq_top (μ := μ) paths

/-- Generated score directions are dense exactly when the concrete pathwise tangent space fills the
entire centered score space. -/
theorem pathwiseGeneratedScores_dense_iff_tangent_eq_top
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) :
    Semiparametric.dqmTangentSpace (μ := μ) paths = ⊤ ↔
      Dense ((Submodule.span ℝ (Semiparametric.dqmScoreSet (μ := μ) paths) :
        Set (Semiparametric.CenteredScoreSpace Ω μ))) :=
  Semiparametric.dqmTangentSpace_eq_top_iff_dense_generatedScores (μ := μ) paths

/-- DQM first-order expansions along admissible local sequences are inherited from the underlying
quadratic-mean differentiability statement. -/
theorem dqmFirstOrderLocalExperimentExpansion_of_tendsto
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ] (p : Semiparametric.DQMPath Ω μ) {τ : ℕ → ℝ}
    (hτ : Filter.Tendsto τ Filter.atTop (nhdsWithin (0 : ℝ) ({0}ᶜ))) :
    Semiparametric.HasFirstOrderLocalExperimentExpansion (μ := μ) p τ :=
  p.hasFirstOrderLocalExperimentExpansion_of_tendsto (μ := μ) hτ

/-- Dominated DQM paths are locally contiguous to the base model along any local-alternative
sequence. -/
theorem dqmLocalAlternatives_contiguous
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ] (p : Semiparametric.DQMPath Ω μ) (τ : ℕ → ℝ) :
    Semiparametric.LocallyContiguous (μ := μ) p τ :=
  p.locallyContiguous (μ := μ) τ

/-- Coordinatewise sample log-likelihood ratios vanish at the base point under the base product
law. -/
theorem sampleLogLikelihoodRatio_vanishesAtBase
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    (p : Semiparametric.DQMPath Ω μ) (n : ℕ) :
    Semiparametric.sampleLogLikelihoodRatio (μ := μ) p n 0 =ᵐ[Semiparametric.baseSampleMeasure μ n] 0 :=
  Semiparametric.sampleLogLikelihoodRatio_atZero_ae_eq_zero (μ := μ) p n

/-- Witness-backed product log-likelihood identity. -/
theorem sampleLogLikelihoodRatio_ae_eq_true_of_witness
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    {p : Semiparametric.DQMPath Ω μ} {n : ℕ} {t : ℝ}
    (w : Semiparametric.ProductLogLikelihoodRatioWitness (μ := μ) p n t) :
    Semiparametric.sampleLogLikelihoodRatio (μ := μ) p n t =ᵐ[Semiparametric.baseSampleMeasure μ n]
      w.trueLogLikelihoodRatio :=
  Semiparametric.sampleLogLikelihoodRatio_ae_eq_true (μ := μ) w

/-- Witness-backed quadratic product-LAN expansion. -/
theorem productLAN_ae_eq_quadratic_plus_remainder
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    {p : Semiparametric.DQMPath Ω μ} {h : ℝ}
    (w : Semiparametric.ProductLANWitness (μ := μ) p h) (n : ℕ) :
    Semiparametric.sampleLogLikelihoodRatio (μ := μ) p n (Semiparametric.localAlternativeScale h n)
      =ᵐ[Semiparametric.baseSampleMeasure μ n]
      fun x =>
        Semiparametric.quadraticLANApproximation (μ := μ) p h n x + w.remainder n x :=
  w.sampleLogLikelihoodRatio_ae_eq_quadratic_plus_remainder n

/-- Dimension-one scalar CLTs upgrade to one-dimensional finite-probe CLTs. -/
theorem scalarCLT_to_finiteProbe_dim1
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ]
    {seq : ℕ → Ω → ℝ} {limit : Ω → ℝ}
    (h : MeasureTheory.TendstoInDistribution seq Filter.atTop limit μ) :
    ProbabilityTheory.FiniteProbeCLT (Ω := Ω) (μ := μ)
      (fun n ω => ProbabilityTheory.scalarToEuclidean1 (seq n ω))
      (fun ω => ProbabilityTheory.scalarToEuclidean1 (limit ω)) :=
  ProbabilityTheory.finiteProbeCLT_of_scalar h

/-- Dimension-one finite-probe CLTs are equivalent to the corresponding scalar convergence
statement. -/
theorem finiteProbeCLT_dim1_iff_scalar
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ]
    {seq : ℕ → Ω → ℝ} {limit : Ω → ℝ} :
    ProbabilityTheory.FiniteProbeCLT (Ω := Ω) (μ := μ)
      (fun n ω => ProbabilityTheory.scalarToEuclidean1 (seq n ω))
      (fun ω => ProbabilityTheory.scalarToEuclidean1 (limit ω)) ↔
      MeasureTheory.TendstoInDistribution seq Filter.atTop limit μ :=
  ProbabilityTheory.finiteProbeCLT_dim1_iff_scalar

/-- Finite-probe drift vanishes for directions orthogonal to the probe span. -/
theorem finiteProbeDrift_eq_zero_of_orthogonal
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    {d : ℕ} (probes : Semiparametric.FiniteProbeFamily (Ω := Ω) (μ := μ) d)
    {g : Semiparametric.CenteredScoreSpace Ω μ}
    (hg : g ∈ (Semiparametric.finiteProbeSpan (μ := μ) probes)ᗮ) :
    Semiparametric.finiteProbeDrift (μ := μ) probes g = 0 :=
  Semiparametric.finiteProbeDrift_eq_zero_of_mem_orthogonal (μ := μ) probes hg

/-- Witness-backed third-lemma shifted means are exactly the finite-probe drift vector. -/
theorem thirdLemma_shiftedMean_eq_finiteProbeDrift
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    {d : ℕ} {probes : Semiparametric.FiniteProbeFamily (Ω := Ω) (μ := μ) d}
    {g : Semiparametric.CenteredScoreSpace Ω μ}
    (w : Semiparametric.FiniteProbeThirdLemmaWitness (μ := μ) probes g) :
    w.shiftedMean = Semiparametric.finiteProbeDrift (μ := μ) probes g :=
  w.shiftedMean_eq_finiteProbeDrift

/-- Exact one-sample log-likelihood formula for exponential tilts. -/
theorem exponentialTilt_localLogLikelihoodRatio_eq
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    (tilt : Semiparametric.ExponentialTiltPath Ω μ) (t : ℝ) :
    MeasureTheory.llr (tilt.path t) μ =ᵐ[μ]
      fun ω =>
        t * tilt.score.toFun ω -
          Real.log (∫ z, Real.exp (t * tilt.score.toFun z) ∂μ) :=
  tilt.localLogLikelihoodRatio_ae_eq (μ := μ) t

/-- Exact finite-sample log-likelihood formula for exponential tilts under the base product law. -/
theorem exponentialTilt_sampleLogLikelihoodRatio_eq
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    (tilt : Semiparametric.ExponentialTiltPath Ω μ) (n : ℕ) (t : ℝ) :
    Semiparametric.exponentialTiltSampleLogLikelihoodRatio (μ := μ) tilt n t
      =ᵐ[Semiparametric.baseSampleMeasure μ n]
      fun x =>
        t * (∑ i, tilt.score.toFun (x i)) -
          (n : ℝ) * Real.log (∫ z, Real.exp (t * tilt.score.toFun z) ∂μ) :=
  tilt.sampleLogLikelihoodRatio_ae_eq (μ := μ) n t

/-- Exact local-alternative expansion for exponential-tilt sample log-likelihood ratios. -/
theorem exponentialTilt_localAlternativeExpansion
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsFiniteMeasure μ]
    (tilt : Semiparametric.ExponentialTiltPath Ω μ) (n : ℕ) (h : ℝ) :
    Semiparametric.exponentialTiltSampleLogLikelihoodRatio (μ := μ) tilt n
        (Semiparametric.localAlternativeScale h n)
      =ᵐ[Semiparametric.baseSampleMeasure μ n]
      fun x =>
        h * Semiparametric.normalizedConcreteScoreSum (μ := μ) tilt.score n x -
          (n : ℝ) *
            Real.log
              (∫ z, Real.exp ((Semiparametric.localAlternativeScale h n) * tilt.score.toFun z) ∂μ) :=
  tilt.sampleLogLikelihoodRatio_localAlternative_ae_eq (μ := μ) n h

/-- Concrete DQM families induce the abstract Gaussian-shift geometry on their tangent space. -/
abbrev dominatedDqmFamily_gaussianShiftExperiment
    (Ω : Type*) [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ)) :=
  Semiparametric.dominatedDqmFamily_inducesGaussianShiftExperiment (μ := μ) paths

/-- Orthogonal directions have zero Gaussian-shift coordinates against any basis of the concrete
DQM tangent space. -/
theorem dqmGaussianShift_orthogonalCoordinates_eq_zero
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ))
    {ι : Type*} (basis : Semiparametric.GaussianShiftBasis ι
      (Semiparametric.dqmTangentSpace (μ := μ) paths))
    {g : Semiparametric.CenteredScoreSpace Ω μ}
    (hg : g ∈ (Semiparametric.dqmTangentSpace (μ := μ) paths)ᗮ) :
    (fun i => inner ℝ (((basis i : Semiparametric.dqmTangentSpace (μ := μ) paths) :
      Semiparametric.CenteredScoreSpace Ω μ)) g) = 0 :=
  Semiparametric.dqmTangentSpace_orthogonalCoordinates_eq_zero (μ := μ) paths basis hg

/-- Concrete coordinate decomposition for dominated DQM tangent spaces. -/
theorem dqmGaussianShift_coordinateDecomposition
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ))
    [((Semiparametric.dqmTangentSpace (μ := μ) paths)).HasOrthogonalProjection]
    (g : Semiparametric.CenteredScoreSpace Ω μ) :
    (Semiparametric.dqmTangentSpace (μ := μ) paths).starProjection g +
        (Semiparametric.dqmTangentSpace (μ := μ) paths)ᗮ.starProjection g =
      g :=
  Semiparametric.dqmTangentSpace_coordinateDecomposition (μ := μ) paths g

/-- Concrete scalarized convolution decomposition for dominated DQM tangent spaces. -/
theorem dqmGaussianShift_scalarizedConvolution
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ))
    [((Semiparametric.dqmTangentSpace (μ := μ) paths)).HasOrthogonalProjection]
    (ψ : Semiparametric.CenteredScoreSpace Ω μ) :
    ψ = (Semiparametric.dqmTangentSpace (μ := μ) paths).starProjection ψ +
      (Semiparametric.dqmTangentSpace (μ := μ) paths)ᗮ.starProjection ψ :=
  Semiparametric.dqmTangentSpace_scalarizedConvolution (μ := μ) paths ψ

/-- Paper Lemma 2.1(i): local just identification is equivalent to a trivial orthogonal
complement. -/
theorem localJustIdentification_iff_trivialOrthogonalComplement
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] :
    Semiparametric.IsLocallyJustIdentified T ↔ Tᗮ = ⊥ :=
  Semiparametric.isLocallyJustIdentified_iff_orthogonalComplement_eq_bot (T := T)

/-- Paper Lemma 2.1(ii): local overidentification is equivalent to a nontrivial orthogonal
complement. -/
theorem localOveridentification_iff_nontrivialOrthogonalComplement
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] :
    Semiparametric.IsLocallyOveridentified T ↔ Tᗮ ≠ ⊥ :=
  Semiparametric.isLocallyOveridentified_iff_orthogonalComplement_ne_bot (T := T)

/-- Paper Lemma 2.1(ii): local overidentification is equivalent to the existence of a nonzero
orthogonal score direction. -/
theorem localOveridentification_iff_exists_nonzeroOrthogonalScore
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] :
    Semiparametric.IsLocallyOveridentified T ↔ ∃ h ∈ Tᗮ, h ≠ (0 : H) :=
  Semiparametric.isLocallyOveridentified_iff_exists_nonzero_orthogonal (T := T)

/-- Concrete pathwise local just identification is equivalent to a trivial orthogonal complement
in centered `L²₀(P)`. -/
theorem pathwiseLocalJustIdentification_iff_trivialOrthogonalComplement
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ))
    [((Semiparametric.dqmTangentSpace (μ := μ) paths)).HasOrthogonalProjection] :
    Semiparametric.IsPathwiseLocallyJustIdentified (μ := μ) paths ↔
      (Semiparametric.dqmTangentSpace (μ := μ) paths)ᗮ = ⊥ :=
  Semiparametric.isPathwiseLocallyJustIdentified_iff_orthogonalComplement_eq_bot
    (μ := μ) paths

/-- Concrete pathwise local overidentification is equivalent to a nonzero orthogonal score
direction in centered `L²₀(P)`. -/
theorem pathwiseLocalOveridentification_iff_exists_nonzeroOrthogonalScore
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure μ]
    (paths : Set (Semiparametric.DQMPath Ω μ))
    [((Semiparametric.dqmTangentSpace (μ := μ) paths)).HasOrthogonalProjection] :
    Semiparametric.IsPathwiseLocallyOveridentified (μ := μ) paths ↔
      ∃ h ∈ (Semiparametric.dqmTangentSpace (μ := μ) paths)ᗮ,
        h ≠ (0 : Semiparametric.CenteredScoreSpace Ω μ) :=
  Semiparametric.isPathwiseLocallyOveridentified_iff_exists_nonzero_orthogonal
    (μ := μ) paths

/-- Paper Theorem 3.1(i): regular estimators are first-order equivalent under local just
identification. -/
theorem regularEstimators_firstOrderEquivalent
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T : Semiparametric.TangentSpace H} {κ : Semiparametric.EfficientInfluenceSystem T ι}
    {ψ φ : ι → H} [T.HasOrthogonalProjection]
    (hJust : Semiparametric.IsLocallyJustIdentified T)
    (hψ : Semiparametric.RegularInfluenceOperator T κ ψ)
    (hφ : Semiparametric.RegularInfluenceOperator T κ φ) :
    ψ = φ :=
  Semiparametric.regularInfluenceOperator_eq_of_locallyJustIdentified hJust hψ hφ

/-- Concrete DQM-path local just identification implies first-order equivalence of regular
influence operators on the centered score space. -/
theorem pathwiseRegularEstimators_firstOrderEquivalent
    {Ω ι : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    {paths : Set (Semiparametric.DQMPath Ω μ)}
    {κ : Semiparametric.EfficientInfluenceSystem (Semiparametric.dqmTangentSpace (μ := μ) paths) ι}
    {ψ φ : ι → Semiparametric.CenteredScoreSpace Ω μ}
    [((Semiparametric.dqmTangentSpace (μ := μ) paths)).HasOrthogonalProjection]
    (hJust : Semiparametric.IsPathwiseLocallyJustIdentified (μ := μ) paths)
    (hψ : Semiparametric.RegularInfluenceOperator (Semiparametric.dqmTangentSpace (μ := μ) paths) κ ψ)
    (hφ : Semiparametric.RegularInfluenceOperator (Semiparametric.dqmTangentSpace (μ := μ) paths) κ φ) :
    ψ = φ :=
  Semiparametric.regularInfluenceOperator_eq_of_pathwiseLocallyJustIdentified
    (μ := μ) hJust hψ hφ

/-- Paper Lemma 3.3(ii): differences of regular linear estimators live in the orthogonal
complement. -/
theorem regularEstimatorDifference_isOrthogonal
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T : Semiparametric.TangentSpace H} {κ : Semiparametric.EfficientInfluenceSystem T ι}
    {ψ φ : ι → H} [T.HasOrthogonalProjection]
    (hψ : Semiparametric.RegularInfluenceOperator T κ ψ)
    (hφ : Semiparametric.RegularInfluenceOperator T κ φ) (i : ι) :
    ψ i - φ i ∈ Tᗮ :=
  Semiparametric.regularInfluenceDifference_mem_orthogonal hψ hφ i

/-- Paper Theorem 3.1(ii): local overidentification permits distinct regular influence
representations. -/
theorem distinctRegularEstimators_exist_underOveridentification
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    [Inhabited ι] [DecidableEq ι]
    {T : Semiparametric.TangentSpace H} {κ : Semiparametric.EfficientInfluenceSystem T ι}
    {ψ : ι → H} [T.HasOrthogonalProjection]
    (hOver : Semiparametric.IsLocallyOveridentified T)
    (hψ : Semiparametric.RegularInfluenceOperator T κ ψ) :
    ∃ ψ' : ι → H, Semiparametric.RegularInfluenceOperator T κ ψ' ∧ ψ' ≠ ψ :=
  Semiparametric.exists_distinct_regularInfluenceOperator_of_locallyOveridentified hOver hψ

/-- Paper Lemma 3.2: unrestricted variance decomposes into efficient and orthogonal pieces. -/
theorem varianceDecomposition
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] (x : H) :
    Semiparametric.FullVarianceBound x =
      Semiparametric.EfficientVarianceBound T x +
        Semiparametric.FullVarianceBound (Tᗮ.starProjection x) :=
  Semiparametric.fullVariance_eq_efficientVariance_add_orthogonalVariance T x

/-- Paper Theorem 3.2 / Theorem E.1 bridge: equality of full and efficient variance on a dense set
characterizes local just identification. -/
theorem varianceEquality_onDenseSet_iff_localJustIdentification
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection]
    {D : Set H} (hDense : Dense D) :
    (∀ x ∈ D, Semiparametric.EfficientVarianceBound T x = Semiparametric.FullVarianceBound x) ↔
      Semiparametric.IsLocallyJustIdentified T :=
  Semiparametric.efficientVariance_eq_fullVariance_iff_locallyJustIdentified_of_dense T hDense

/-- Paper Lemma 3.4: maintained-model score decompositions. -/
theorem maintainedModelScoreDecomposition
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T M : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] [M.HasOrthogonalProjection]
    (hTleM : T ≤ M) :
    T ⊔ (Tᗮ ⊓ M) = M :=
  Semiparametric.maintainedModelDecomposition (T := T) (M := M) hTleM

/-- Paper Lemma 3.4: the full score decomposes into tangent, orthogonal, and maintained-model
components. -/
theorem fullScoreDecomposition
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T M : Semiparametric.TangentSpace H) [T.HasOrthogonalProjection] [M.HasOrthogonalProjection]
    (hTleM : T ≤ M) :
    T ⊔ (Tᗮ ⊓ M) ⊔ Mᗮ = ⊤ :=
  Semiparametric.fullScoreDecomposition (T := T) (M := M) hTleM

/-- Paper Equation (25) and incremental-Sargan expansion. -/
theorem incrementalSarganOrthogonalCharacterization
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T M : Semiparametric.TangentSpace H} {κ : Semiparametric.EfficientInfluenceSystem T ι}
    {ψ φ : ι → H} [T.HasOrthogonalProjection] [M.HasOrthogonalProjection]
    (hTleM : T ≤ M)
    (hψ : Semiparametric.EfficientInfluenceOperator T κ ψ)
    (hφ : Semiparametric.RegularInfluenceOperator T κ φ)
    (hφM : ∀ i, φ i ∈ M) (i : ι) :
    ψ i - φ i ∈ Tᗮ ⊓ M :=
  Semiparametric.regularDifference_mem_incrementalSargan hTleM hψ hφ hφM i

/-- Paper Theorem B.1: Gaussian-shift coordinates split into tangent and orthogonal drift
components. -/
theorem gaussianShift_coordinateDecomposition
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T : Semiparametric.TangentSpace H} [T.HasOrthogonalProjection]
    (g : H) :
    T.starProjection g + Tᗮ.starProjection g = g :=
  Semiparametric.gaussianShiftCoordinateDecomposition T g

/-- Paper Theorem B.1(ii): scalarized convolution decomposition for Gaussian-shift limit
experiments. -/
theorem gaussianShift_scalarizedConvolution
    {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T : Semiparametric.TangentSpace H} [T.HasOrthogonalProjection]
    (ψ : H) :
    ψ = T.starProjection ψ + Tᗮ.starProjection ψ :=
  Semiparametric.scalarizedConvolutionDecomposition T ψ

/-- Paper Theorem A.1 / Lemma A.1: local just identification for cones is equivalent to a trivial
inner dual cone. -/
theorem coneLocalJustIdentification_iff_trivialInnerDual
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (C : Semiparametric.ClosedConvexCone H) :
    Semiparametric.IsLocallyJustIdentifiedCone C ↔ ProperCone.innerDual (C : Set H) = ⊥ :=
  Semiparametric.isLocallyJustIdentifiedCone_iff_innerDual_eq_bot C

/-- Paper Theorem A.2 / Lemma A.2: local overidentification for cones is equivalent to a
nontrivial inner dual cone. -/
theorem coneLocalOveridentification_iff_nontrivialInnerDual
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (C : Semiparametric.ClosedConvexCone H) :
    Semiparametric.IsLocallyOveridentifiedCone C ↔ ProperCone.innerDual (C : Set H) ≠ ⊥ :=
  Semiparametric.isLocallyOveridentifiedCone_iff_innerDual_ne_bot C

/-- Paper Theorem A.3 / Lemma A.2: local overidentification for cones yields a nonzero dual
direction. -/
theorem coneLocalOveridentification_iff_exists_nonzeroInnerDual
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
