    {H W S : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
    [AddCommGroup S] [Module ℝ S]
    {model : Econometrics.ConditionalMoments.LinearizedModel H W S}
    (family : Econometrics.ConditionalMoments.DQMAssociatedFamily (Ω := Ω) (μ := μ) model) :
    Semiparametric.IsPathwiseLocallyOveridentified (μ := μ) family.paths ↔
      Econometrics.ConditionalMoments.IsLocallyOveridentified model :=
  family.pathwiseLocallyOveridentified_iff_modelOveridentified

/-- Pathwise local overidentification in a conditional-moment model yields a strictly positive
orthogonal-score drift direction. -/
theorem conditionalMomentPathwiseOveridentified_yieldsPositiveScoreDrift
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsFiniteMeasure μ]
    {H W : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
    {model : Econometrics.ConditionalMoments.LinearizedModel H W W}
    (family : Econometrics.ConditionalMoments.DQMAssociatedFamily (Ω := Ω) (μ := μ) model)
    (hOver : Semiparametric.IsPathwiseLocallyOveridentified (μ := μ) family.paths) :
    ∃ s ∈ Econometrics.ConditionalMoments.orthogonalScoreSpace model,
      0 < Econometrics.ConditionalMoments.orthogonalScoreLocalDrift s :=
  family.pathwiseOveridentified_yields_positiveScoreDrift hOver

