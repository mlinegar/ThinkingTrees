section Theorem2_Helpers_2

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)] [OpensMeasurableSpace (FreeMonoid S)]
variable [MeasurableSingletonClass (FreeMonoid S)] [Countable (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))

lemma ae_mem_range_g (x : FreeMonoid S) : ∀ᵐ z ∂(g x), z ∈ RangeG g := by
  have h_diff_uncurry : ∀ᵐ z ∂(g x), z ∈ (g x).support := by
    simp +decide [ MeasureTheory.ae_iff ];
    -- Since the support of a measure is the set of points where the measure is positive, if a is not in the support, then the measure at a is zero.
    have h_support : ∀ a, a ∉ (g x).support → (g x) {a} = 0 := by
      simp +contextual [ MeasureTheory.Measure.mem_support_iff ];
      intro a ha;
      contrapose! ha;
      simp +decide [ ha, Filter.eventually_smallSets ];
      exact fun U hU => ⟨ { a }, Set.singleton_subset_iff.mpr ( mem_of_mem_nhds hU ), ha ⟩;
    rw [ show { a : FreeMonoid S | a ∉ ( g x |> MeasureTheory.Measure.support ) } = ⋃ a ∈ { a : FreeMonoid S | a ∉ ( g x |> MeasureTheory.Measure.support ) }, { a } by ext; aesop, MeasureTheory.measure_iUnion_null_iff ] ; aesop;
  exact h_diff_uncurry.mono fun z hz => ⟨ x, hz ⟩

lemma ae_in_range_g_reduceg (T : ReductionTree S) :
  ∀ᵐ z ∂(reduceg g T), z ∈ RangeG g := by
    induction' T with T_l T_r ih_l ih_r;
    · -- Since the support of a measure is the set of points where the measure is non-zero, and h_support says that this set is contained in RangeG g, the measure of the set where the measure is non-zero (which is the support) is zero outside of RangeG g.
      have h_ae_support : ∀ᵐ z ∂(g T_l), z ∈ RangeG g := by
        exact?;
      exact h_ae_support;
    · -- By definition of `reduceg`, we have `reduceg g (T_r.node ih_l) = (reduceg g T_r ⊗ₘ reduceg g ih_l) >>= g`.
      have h_bind : reduceg g (T_r.node ih_l) = (Measure.bind ((Measure.prod (reduceg g T_r) (reduceg g ih_l)).map (fun p => p.1 * p.2)) g) := by
        exact?;
      rw [ h_bind ];
      exact?

lemma ae_in_range_g_reduceg_multi (T : ReductionTree S) (n : ℕ) :
  ∀ᵐ z ∂(reduceg_multi g T n), z ∈ RangeG g := by
    induction' n with n ih generalizing T;
    · -- By definition of `reduceg`, we know that `reduceg g T` is a measure on `FreeMonoid S`.
      have h_support : ∀ (T : ReductionTree S), ∀ᵐ z ∂(reduceg g T), z ∈ RangeG g := by
        exact?;
      exact h_support T;
    · convert ae_range_g_of_bind g _ using 1

end Theorem2_Helpers_2

