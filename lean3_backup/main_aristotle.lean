/-
We define the first local law L1: Leaf sufficiency in expectation.
For a leaf node with string `s`, the expected distance between the oracle value of the summary `z` (drawn from `g s`) and the oracle value of `s` is 0.
For a non-leaf node, L1 must hold for both children.
-/
open ProbabilityTheory MeasureTheory

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

/-- L1: Leaf sufficiency in expectation. -/
noncomputable def SatisfiesL1 (T : ReductionTree S) : Prop :=
match T with
| .leaf s => ∫ z, dist (fstar z) (fstar s) ∂(g s) = 0
| .node l r => SatisfiesL1 l ∧ SatisfiesL1 r

/-
We define the second local law L2: Parentwise compatibility.
For a leaf node, it is trivially true.
For a non-leaf node, the expected distance between the oracle value of the summary at that node (computed by `reduceg`) and the oracle value of the realized string at that node is 0.
Also, L2 must hold for both children.
-/
open ProbabilityTheory MeasureTheory

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

/-- L2: Parentwise compatibility. -/
noncomputable def SatisfiesL2 (T : ReductionTree S) : Prop :=
match T with
| .leaf _ => True
| .node l r =>
  (∫ z, dist (fstar z) (fstar (realizedString (.node l r))) ∂(reduceg g (.node l r)) = 0) ∧
  SatisfiesL2 l ∧ SatisfiesL2 r

/-
We define the third local law L3: On-range stability.
It states that for any string `z` that is in the support of `g x` for some `x` (i.e., `z` is a possible output of the summarizer), re-summarizing `z` (drawing `z'` from `g z`) does not change the oracle value in expectation.
We also define `reduceg_multi`, which applies the reduction `n` times.
Base case 0 is just the standard reduction.
Step n+1 binds the result of step n to `g`.
-/
open ProbabilityTheory MeasureTheory

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

/-- L3: On-range stability. -/
def SatisfiesL3 : Prop :=
  ∀ z, (∃ x, z ∈ (g x).support) → ∫ z', dist (fstar z') (fstar z) ∂(g z) = 0

/-- Multi-round reduction. -/
noncomputable def reduceg_multi (T : ReductionTree S) : ℕ → Measure (FreeMonoid S)
| 0 => reduceg g T
| n + 1 => Measure.bind (reduceg_multi T n) g

/-
Theorem 1: If the local laws L1 (leaf sufficiency) and L2 (parentwise compatibility) hold for a reduction tree T, then the expected distortion of the oracle value at the root of the tree is 0.
-/
open ProbabilityTheory MeasureTheory

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

/-- Theorem 1: One-pass preservation. -/
theorem Theorem1 (T : ReductionTree S) :
  SatisfiesL1 g fstar T → SatisfiesL2 g fstar T →
  ∫ z, dist (fstar z) (fstar (realizedString T)) ∂(reduceg g T) = 0 := by
    -- Prove that `SatisfiesL2` implies the theorem statement for root nodes.
    have root_cond : ∀ {l r : ReductionTree S}, (SatisfiesL2 g fstar (.node l r)) → (∫ z, (dist (fstar z) (fstar (realizedString (.node l r)))) ∂(reduceg g (.node l r))) = 0 := by
      exact fun { l r } h => h.1;
    induction T <;> aesop

