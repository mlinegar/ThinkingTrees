/-- Lemma: SatisfiesL3 implies zero expected distortion for z in RangeG. -/
lemma SatisfiesL3_of_RangeG_v5 (h : SatisfiesL3 g fstar) :
  ∀ z ∈ RangeG_v5 g, ∫ z', dist (fstar z') (fstar z) ∂(g z) = 0 := by
    -- By definition of `SatisfiesL3`, for any `z` in the range of `g`, the integral of the distance between `fstar z'` and `fstar z` over `z'` in the support of `g z` is zero.
    intros z hz
    apply h z hz

/-- Lemma: Almost everywhere in g x is in RangeG. -/
lemma ae_mem_range_g_v5 (x : FreeMonoid S) : ∀ᵐ z ∂(g x), z ∈ RangeG_v5 g := by
  -- Since the measure g x is a probability measure, and the support of g x is the set of points where the measure is non-zero, then for almost every z, z is in the support of g x.
  have h_support : ∀ᵐ z ∂(g x), z ∈ (g x).support := by
    by_contra h_contra;
    -- If the set where z is not in the support of g x has positive measure, then the measure of the support is less than 1, which contradicts the fact that g x is a probability measure.
    have h_measure_support : (g x).supportᶜ ⊆ {z | (g x) {z} = 0} := by
      intro z hz
      simp [MeasureTheory.Measure.support] at hz;
      rw [ Filter.eventually_smallSets ] at hz;
      exact hz.choose_spec.2 _ ( Set.singleton_subset_iff.mpr ( mem_of_mem_nhds hz.choose_spec.1 ) );
    have h_measure_support : (g x).supportᶜ ⊆ ⋃ z ∈ (g x).supportᶜ, {z} := by
      exact fun z hz => Set.mem_iUnion₂.2 ⟨ z, hz, rfl ⟩;
    have h_measure_support : (g x) (⋃ z ∈ (g x).supportᶜ, {z}) = 0 := by
      aesop;
    exact h_contra ( MeasureTheory.measure_mono_null ‹_› h_measure_support );
  exact h_support.mono fun z hz => ⟨ x, hz ⟩

/-- Lemma: If a property holds a.e. for g x for all x, it holds a.e. for bind μ g. -/
lemma ae_bind_of_forall_ae_v5 {μ : Measure (FreeMonoid S)} {P : FreeMonoid S → Prop}
  (h : ∀ x, ∀ᵐ z ∂(g x), P z) :
  ∀ᵐ z ∂(Measure.bind μ g), P z := by
    exact?

/-- Lemma: The output of reduceg is almost everywhere in RangeG. -/
lemma ae_in_range_g_reduceg_v5 (T : ReductionTree S) :
  ∀ᵐ z ∂(reduceg g T), z ∈ RangeG_v5 g := by
    apply_rules [ ae_in_range_g_reduceg_v4 ]

/-- Lemma: The output of reduceg_multi is almost everywhere in RangeG. -/
lemma ae_in_range_g_reduceg_multi_v5 (T : ReductionTree S) (n : ℕ) :
  ∀ᵐ z ∂(reduceg_multi g T n), z ∈ RangeG_v5 g := by
    -- Apply the lemma `ae_bind_of_forall_ae` to show that the property holds almost everywhere for the bind measure.
    apply ae_in_range_g_reduceg_multi_v4

end Theorem2_Helpers_v5

/-
Proving `Theorem1_Proven`. It follows directly from the definitions of `SatisfiesL1` and `SatisfiesL2`.
-/
open ProbabilityTheory MeasureTheory

section Theorem1_Proof

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

theorem Theorem1_Proven (T : ReductionTree S) :
  SatisfiesL1 g fstar T → SatisfiesL2 g fstar T →
  ∫ z, dist (fstar z) (fstar (realizedString T)) ∂(reduceg g T) = 0 := by
  intro h1 h2
  cases T with
  | leaf s =>
    simp [realizedString, reduceg]
    unfold SatisfiesL1 at h1
    exact h1
  | node l r =>
    unfold SatisfiesL2 at h2
    exact h2.1

end Theorem1_Proof

/-
Proving helper lemmas `SatisfiesL3_of_RangeG_v6`, `ae_mem_range_g_v6`, `ae_bind_of_forall_ae_v6`, `ae_in_range_g_reduceg_v6`, and `ae_in_range_g_reduceg_multi_v6` with correct names and proofs.
-/
open ProbabilityTheory MeasureTheory

section Theorem2_Helpers_v6

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)] [OpensMeasurableSpace (FreeMonoid S)]
variable [MeasurableSingletonClass (FreeMonoid S)] [Countable (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

/-- The range of the summarizer g, defined as the union of supports. -/
def RangeG_v6 : Set (FreeMonoid S) := {z | ∃ x, z ∈ (g x).support}

/-- Lemma: SatisfiesL3 implies zero expected distortion for z in RangeG. -/
lemma SatisfiesL3_of_RangeG_v6 (h : SatisfiesL3 g fstar) :
  ∀ z ∈ RangeG_v6 g, ∫ z', dist (fstar z') (fstar z) ∂(g z) = 0 := by
    exact?

/-- Lemma: Almost everywhere in g x is in RangeG. -/
lemma ae_mem_range_g_v6 (x : FreeMonoid S) : ∀ᵐ z ∂(g x), z ∈ RangeG_v6 g := by
  refine' MeasureTheory.measure_mono_null _ _;
  exact { z | z ∉ ( g x |> MeasureTheory.Measure.support ) };
  · exact fun z hz => fun h => hz ⟨ x, h ⟩;
  · -- The support of the measure is the set of points where the measure is non-zero. Therefore, the complement of the support is the set where the measure is zero.
    simp [MeasureTheory.Measure.support];
    refine' MeasureTheory.measure_mono_null _ _;
    exact { z | ( g x ) { z } = 0 };
    · intro z hz;
      contrapose! hz;
      simp_all +decide [ Filter.eventually_smallSets ];
      exact fun U hU => ⟨ { z }, by simpa using mem_of_mem_nhds hU, hz ⟩;
    · -- Since the set {z | (g x) {z} = 0} is countable, its measure is zero.
      have h_countable : Set.Countable {z | (g x) {z} = 0} := by
        exact Set.to_countable _;
      exact?

/-- Lemma: If a property holds a.e. for g x for all x, it holds a.e. for bind μ g. -/
lemma ae_bind_of_forall_ae_v6 {μ : Measure (FreeMonoid S)} {P : FreeMonoid S → Prop}
  (h : ∀ x, ∀ᵐ z ∂(g x), P z) :
  ∀ᵐ z ∂(Measure.bind μ g), P z := by
    exact?

/-- Lemma: The output of reduceg is almost everywhere in RangeG. -/
lemma ae_in_range_g_reduceg_v6 (T : ReductionTree S) :
  ∀ᵐ z ∂(reduceg g T), z ∈ RangeG_v6 g := by
    -- By definition of `reduceg`, the output is a measure that is supported on the range of `g`.
    have h_support : ∀ T : ReductionTree S, ∀ᵐ z ∂(reduceg g T), z ∈ RangeG_v6 g := by
      have := @ae_in_range_g_reduceg;
      convert this g using 1;
    exact h_support T

/-- Lemma: The output of reduceg_multi is almost everywhere in RangeG. -/
lemma ae_in_range_g_reduceg_multi_v6 (T : ReductionTree S) (n : ℕ) :
  ∀ᵐ z ∂(reduceg_multi g T n), z ∈ RangeG_v6 g := by
    convert ae_in_range_g_reduceg_multi_v5 g T n using 1

end Theorem2_Helpers_v6

