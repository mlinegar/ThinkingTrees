/-
We define the `ReductionTree` structure, the `realizedString` function which concatenates the strings at the leaves, and the `reduceg` function which computes the distribution of the summary at the root of the tree given a summarizer kernel `g`. We use `S` for the alphabet type to avoid conflict with `Σ`.
-/
open ProbabilityTheory MeasureTheory

section Setup

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]

/-- A reduction tree T is any full binary tree whose leaves are blocks. -/
inductive ReductionTree (S : Type*)
| leaf (s : FreeMonoid S)
| node (left right : ReductionTree S)

/-- The realized string at node u, S(u). -/
def realizedString : ReductionTree S → FreeMonoid S
| .leaf s => s
| .node l r => realizedString l * realizedString r

/-- The hierarchical reduction reduce_g(T). -/
noncomputable def reduceg (g : Kernel (FreeMonoid S) (FreeMonoid S)) : ReductionTree S → Measure (FreeMonoid S)
| .leaf s => g s
| .node l r =>
  let μL := reduceg g l
  let μR := reduceg g r
  Measure.bind ((Measure.prod μL μR).map (fun p => p.1 * p.2)) g

end Setup

