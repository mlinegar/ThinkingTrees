/-
Proving helper lemmas for DPO: `IsProbabilityMeasure` instances for `reduceg` and `reduceg_multi`, and `DPO_Integrand_Eq` which shows that the loss integral depends only on the oracle value.
-/
open ProbabilityTheory MeasureTheory Real

section DPO_Lemmas

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)] [OpensMeasurableSpace (FreeMonoid S)]
variable [MeasurableSingletonClass (FreeMonoid S)] [Countable (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable {A : Type*} [MeasurableSpace A]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))
variable (fstar : FreeMonoid S → Y)

-- Ensure DiscreteMeasurableSpace is available
instance : DiscreteMeasurableSpace (FreeMonoid S) := MeasurableSingletonClass.toDiscreteMeasurableSpace

/-- Lemma: reduceg produces a probability measure if g is a Markov kernel. -/
instance reduceg_isProbabilityMeasure (T : ReductionTree S) [IsMarkovKernel g] :
  IsProbabilityMeasure (reduceg g T) := by
    induction' T with T hT;
    · -- Since `g` is a Markov kernel, each `g x` is a probability measure. Therefore, the measure for the leaf node is a probability measure.
      have h_leaf_prob : ∀ x, MeasureTheory.IsProbabilityMeasure (g x) := by
        exact?;
      exact h_leaf_prob T;
    · constructor;
      simp +decide [ reduceg ];
      rw [ MeasureTheory.Measure.map_apply ];
      · simp +decide [ MeasureTheory.IsProbabilityMeasure.measure_univ ];
      · exact?;
      · exact MeasurableSet.univ

/-- Lemma: reduceg_multi produces a probability measure if g is a Markov kernel. -/
instance reduceg_multi_isProbabilityMeasure (T : ReductionTree S) (n : ℕ) [IsMarkovKernel g] :
  IsProbabilityMeasure (reduceg_multi g T n) := by
    induction' n with n ih generalizing T <;> simp_all +decide [ reduceg_multi ];
    · exact?;
    · constructor ; aesop

/-- Lemma: If oracle values are equal, the DPO loss integrals are equal. -/
lemma DPO_Integrand_Eq (policy ref_policy : Policy S A) (h_pol : OracleMeasurable policy fstar) (h_ref : OracleMeasurable ref_policy fstar)
  (gen : PairGenerator S A) (hgen : OracleIndexed gen fstar)
  (β : ℝ) (z x : FreeMonoid S) (h_dist : dist (fstar z) (fstar x) = 0) :
  (∫ p, DPOLossPointwise policy ref_policy β z p.1 p.2 ∂(gen z)) =
  (∫ p, DPOLossPointwise policy ref_policy β x p.1 p.2 ∂(gen x)) := by
    rw [ hgen _ _ h_dist ];
    -- Since policy and ref_policy are oracle-measurable, their values at z and x are equal.
    have h_policy_eq : ∀ a, policy z a = policy x a := by
      exact fun a => h_pol z x a h_dist
    have h_ref_policy_eq : ∀ a, ref_policy z a = ref_policy x a := by
      exact fun a => h_ref z x a h_dist;
    -- Since the integrand is the same in both cases, the integrals must be equal.
    simp [DPOLossPointwise, h_policy_eq, h_ref_policy_eq]

end DPO_Lemmas