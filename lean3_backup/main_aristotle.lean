section Theorem2_Lemmas

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [TopologicalSpace (FreeMonoid S)] [OpensMeasurableSpace (FreeMonoid S)]
variable [MeasurableSingletonClass (FreeMonoid S)] [Countable (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable (g : Kernel (FreeMonoid S) (FreeMonoid S))

/-- The range of the summarizer g, defined as the union of supports. -/
def RangeG : Set (FreeMonoid S) := {z | ∃ x, z ∈ (g x).support}

/-- Lemma: The support of a bind measure into g is contained in RangeG. -/
lemma ae_range_g_of_bind (μ : Measure (FreeMonoid S)) :
  ∀ᵐ z ∂(Measure.bind μ g), z ∈ RangeG g := by
    unfold RangeG;
    rw [ MeasureTheory.ae_iff ];
    have h_empty : ∀ x : FreeMonoid S, (g x) {a : FreeMonoid S | ∀ y : FreeMonoid S, a ∉ (g y).support} = 0 := by
      intro x;
      by_contra h_nonzero;
      obtain ⟨a, ha⟩ : ∃ a : FreeMonoid S, a ∈ {a : FreeMonoid S | ∀ y : FreeMonoid S, a ∉ (g y).support} ∧ (g x) {a} ≠ 0 := by
        have h_empty : (g x) {a : FreeMonoid S | ∀ y : FreeMonoid S, a ∉ (g y).support} = ∑' a, (g x) {a} * (if ∀ y : FreeMonoid S, a ∉ (g y).support then 1 else 0) := by
          rw [ show { a : FreeMonoid S | ∀ y : FreeMonoid S, a ∉ ( g y ).support } = ⋃ a ∈ { a : FreeMonoid S | ∀ y : FreeMonoid S, a ∉ ( g y ).support }, { a } by ext; aesop, MeasureTheory.measure_iUnion ];
          · exact tsum_congr fun a => by split_ifs <;> simp +decide [ * ] ;
          · intro a b hab; simp_all +decide [ Set.disjoint_left ] ;
          · exact fun i => MeasurableSet.iUnion fun _ => MeasurableSingletonClass.measurableSet_singleton _;
        simp_all +decide [ ENNReal.tsum_eq_zero ];
      simp_all +decide [ MeasureTheory.Measure.mem_support_iff ];
      simp_all +decide [ Filter.eventually_smallSets ];
      obtain ⟨ s, hs₁, hs₂ ⟩ := ha.1 x;
      exact ha.2 ( hs₂ { a } ( by simpa using mem_of_mem_nhds hs₁ ) );
    rw [ MeasureTheory.Measure.bind_apply ];
    · aesop;
    · exact?;
    · exact?

end Theorem2_Lemmas

