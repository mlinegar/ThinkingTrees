/-
Redefining DPO setup with explicit `Real.sigmoid` and correct typeclass arguments for `PairGenerator`.
-/
open ProbabilityTheory MeasureTheory Real

section DPO_Setup_v3

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable {A : Type*} [MeasurableSpace A] -- Action space

variable (fstar : FreeMonoid S → Y)

/-- A policy policy(a | x) is a probability density or mass function. 
    We represent it as a function FreeMonoid S → A → ℝ. -/
def Policy (S A : Type*) := FreeMonoid S → A → ℝ

/-- A policy is oracle-measurable if it depends on x only through f*(x). -/
def OracleMeasurable (policy : Policy S A) (fstar : FreeMonoid S → Y) : Prop :=
  ∀ x x' a, dist (fstar x) (fstar x') = 0 → policy x a = policy x' a

/-- The Bradley-Terry-Luce preference model given rewards R. 
    P(a_w > a_l | x) = σ(β * (R(x, a_w) - R(x, a_l))) -/
noncomputable def PreferenceProb (R : FreeMonoid S → A → ℝ) (β : ℝ) (x : FreeMonoid S) (aw al : A) : ℝ :=
  Real.sigmoid (β * (R x aw - R x al))

/-- The DPO loss for a single example (x, aw, al). 
    L(policy; ref_policy) = -log σ(β * log(policy(aw|x)/ref_policy(aw|x)) - β * log(policy(al|x)/ref_policy(al|x))) -/
noncomputable def DPOLossPointwise (policy ref_policy : Policy S A) (β : ℝ) (x : FreeMonoid S) (aw al : A) : ℝ :=
  - log (Real.sigmoid (β * (log (policy x aw / ref_policy x aw) - log (policy x al / ref_policy x al))))

/-- A pair generator maps a document to a measure over pairs of actions. -/
def PairGenerator (S A : Type*) [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)] [MeasurableSpace A] := FreeMonoid S → Measure (A × A)

/-- The pair generator depends on X only through f*(X). -/
def OracleIndexed (gen : PairGenerator S A) (fstar : FreeMonoid S → Y) : Prop :=
  ∀ x x', dist (fstar x) (fstar x') = 0 → gen x = gen x'

end DPO_Setup_v3

/-
Defining `ExpectedDPOLoss`.
-/
open ProbabilityTheory MeasureTheory Real

section DPO_Loss_Def

variable {S : Type*} [MeasurableSpace S] [MeasurableSpace (FreeMonoid S)]
variable {Y : Type*} [PseudoMetricSpace Y] [MeasurableSpace Y]
variable {A : Type*} [MeasurableSpace A]

variable (fstar : FreeMonoid S → Y)

/-- The expected DPO loss over the population μ and pair generator gen. -/
noncomputable def ExpectedDPOLoss (policy ref_policy : Policy S A) (β : ℝ) (μ : Measure (FreeMonoid S)) (gen : PairGenerator S A) : ℝ :=
  ∫ x, ∫ p, DPOLossPointwise policy ref_policy β x p.1 p.2 ∂(gen x) ∂μ

end DPO_Loss_Def

