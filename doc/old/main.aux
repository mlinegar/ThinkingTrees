\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spotlight view of the three local conditions. (A) Leaf sufficiency compares a raw block $b_i$ to its summary $s_i$. (B) Idempotence re-summarizes an internal span $s_{34}$ and checks whether $f^{\ast }(s)$ drifts after calling $g$ again. (C) Merge consistency contrasts the ``tree path'' summaries $s_{56}$ with a direct summary of the joint raw span $b_{56}$. The gray tree anchors the realized hierarchy while the colored panels highlight the local prompts we can audit or optimize.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:local_compatibility}{{3}{12}{Spotlight view of the three local conditions. (A) Leaf sufficiency compares a raw block $b_i$ to its summary $s_i$. (B) Idempotence re-summarizes an internal span $s_{34}$ and checks whether $\fstar (s)$ drifts after calling $g$ again. (C) Merge consistency contrasts the ``tree path'' summaries $s_{56}$ with a direct summary of the joint raw span $b_{56}$. The gray tree anchors the realized hierarchy while the colored panels highlight the local prompts we can audit or optimize}{figure.3}{}}
\newlabel{fig:probabilistic_audit}{{3}{12}{Spotlight view of the three local conditions. (A) Leaf sufficiency compares a raw block $b_i$ to its summary $s_i$. (B) Idempotence re-summarizes an internal span $s_{34}$ and checks whether $\fstar (s)$ drifts after calling $g$ again. (C) Merge consistency contrasts the ``tree path'' summaries $s_{56}$ with a direct summary of the joint raw span $b_{56}$. The gray tree anchors the realized hierarchy while the colored panels highlight the local prompts we can audit or optimize}{figure.3}{}}
