\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hierarchical summarization as a binary tree. Each leaf block $b_i$ is summarized once to produce $s_i = g(b_i)$. Internal nodes recursively summarize the concatenation of their children's stored strings, e.g., $s_{12} = g(s_1 \oplus s_2)$ and $s_{\mathrm  {root}} = g(s_{1234} \oplus s_{5678})$. The latent raw text under a node is denoted $S(u)$ for analysis, but the system only materializes the summaries $s_u$, making every merge auditable from bounded inputs.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:hierarchical_summarization}{{2}{10}{Hierarchical summarization as a binary tree. Each leaf block $b_i$ is summarized once to produce $s_i = g(b_i)$. Internal nodes recursively summarize the concatenation of their children's stored strings, e.g., $s_{12} = g(s_1 \concat s_2)$ and $s_{\mathrm {root}} = g(s_{1234} \concat s_{5678})$. The latent raw text under a node is denoted $S(u)$ for analysis, but the system only materializes the summaries $s_u$, making every merge auditable from bounded inputs}{figure.2}{}}
